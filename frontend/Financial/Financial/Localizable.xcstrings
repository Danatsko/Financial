    "budget.successWithin" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nice! You stayed within your %.2f budget in %@. Only %.2f spent — %.2f left! 🚀"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чудово! Ти вклався в бюджет %.2f у %@. Витрати — лише %.2f, залишок — %.2f! 🚀"
          }
        }
      }
    },
    "budget.warningExceeded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oops! You went over your budget (%.2f) in %@. You spent %.2f — %.2f over. Try planning a bit tighter next month 📉"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ой! Ти перевищив(ла) бюджет (%.2f) у %@. Витрати склали %.2f — це на %.2f більше. Спробуй трохи жорсткіше планувати наступного місяця 📉"
          }
        }
      }
